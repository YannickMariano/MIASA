PORT=4000
FRONTEND_URL=http://localhost:5173
DEVICE_API_KEY=change-me-in-production
AI_SERVICE_URL=http://127.0.0.1:8000
# Endpoint Hugging Face dédié servant un modèle PlantVillage.
# Modèle conseillé : kimcomehome/plantvillage-vit-leaf-disease
HF_ENDPOINT_URL=
HF_TOKEN=
# ESP32 branché en USB : détection automatique du port.
# Forcer un port précis si besoin (ex. COM5 sous Windows, /dev/ttyUSB0 sous Linux).
SERIAL_PORT=
# Mettre "off" pour désactiver la lecture USB (ex. pendant un téléversement du firmware).
SERIAL_BRIDGE=on

# Liaison MQTT (mettre SERIAL_BRIDGE=off lorsque l'ESP32 utilise le Wi-Fi).
MQTT_ENABLED=false
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=tanimboly
MQTT_PASSWORD=change-me
MQTT_BASE_TOPIC=tanimboly
